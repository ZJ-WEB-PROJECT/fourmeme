# ─── 合约地址（必填，等客户提供后替换）─────────────────────────────────────
# 从 Registry.openFourCore() 推导出 Core 地址，Core 抛出 TokenCreated 事件
REGISTRY_ADDRESS=0x_FILL_IN_REGISTRY_ADDRESS

# ─── BSC RPC ──────────────────────────────────────────────────────────────────
BSC_RPC=https://bsc-dataseed.binance.org/

# ─── 起始区块（合约部署所在区块，填入后可跳过扫旧区块，提升启动速度）─────────
# 不填则从 0 开始扫，BSC 区块数量庞大，强烈建议填写
START_BLOCK=0

# ─── 索引参数 ─────────────────────────────────────────────────────────────────
# getLogs 每次查询的区块范围（BSC 公开节点通常限制 ≤ 5000）
CHUNK_SIZE=2000
# 轮询新区块的间隔（毫秒）
POLL_INTERVAL_MS=15000

# ─── API 服务 ─────────────────────────────────────────────────────────────────
API_PORT=3001
# 允许跨域的前端地址（多个用逗号分隔）
CORS_ORIGINS=http://localhost:3000

# ─── 数据库路径 ───────────────────────────────────────────────────────────────
DB_PATH=./data/fourmeme.db
