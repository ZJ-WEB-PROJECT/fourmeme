# ─── 合约地址（等客户提供后填入）─────────────────────────────────────────────
REGISTRY_ADDRESS=0x9ffFF5805625AaC7ad8fa4E7e926b4c1A9E0276F

# ─── BSC RPC ──────────────────────────────────────────────────────────────────
BSC_RPC=https://bsc-rpc.publicnode.com

# ─── 起始区块（合约部署块，可大幅提升启动速度，不填从 0 开始）──────────────
START_BLOCK=100896263

# ─── 索引参数 ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=2000
POLL_INTERVAL_MS=15000

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=4001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ─── 数据库 ───────────────────────────────────────────────────────────────────
DB_PATH=./data/fourmeme.db
